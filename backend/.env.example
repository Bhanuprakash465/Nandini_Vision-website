# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=nandini_vision

# Auth. Generate a real secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS: the exact URL of the deployed frontend (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Owner notification email (Resend). Leave RESEND_API_KEY empty to run in mock mode.
# Note: Resend's onboarding@resend.dev sender can only deliver to the Resend account owner's address.
RESEND_API_KEY=
EMAIL_FROM=Nandini Vision <onboarding@resend.dev>
OWNER_EMAIL=

# Customer confirmation email (Gmail SMTP). Use a Gmail App Password, not the account password.
# Leave empty to run in mock mode (nothing is sent, the API reports "mock").
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# WhatsApp (digits only, with country code)
WHATSAPP_NUMBER=

# Admin bootstrap (used only by seed_admin.py). Choose your own values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
