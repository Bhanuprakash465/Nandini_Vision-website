# Nandini Vision backend environment
# Copy to .env and adjust for real deployments.

APP_ENV=development

# Database — leave empty for the in-memory dev fallback.
# Set REQUIRE_MONGODB=1 to fail fast instead of falling back.
MONGODB_URI=
MONGODB_DB=nandini_vision
REQUIRE_MONGODB=0

# Admin dashboard credentials (SECRET — never expose to the frontend)
ADMIN_EMAIL=admin@nandinistudio.demo
ADMIN_PASSWORD=Nandini@2026
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=72

# Notifications — real email delivery is NOT configured yet.
# Keep NOTIFY_MODE=mock until a provider + API key exists.
NOTIFY_MODE=mock
EMAIL_FROM=hello@nandinistudio.demo
# RESEND_API_KEY=

# Frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
