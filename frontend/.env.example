# URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this site (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional business details. Anything left empty is hidden from the site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_HANDLE=
# Digits only, with country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional real showreel. Without these no video player is shown.
NEXT_PUBLIC_SHOWREEL_URL=
NEXT_PUBLIC_SHOWREEL_POSTER=
